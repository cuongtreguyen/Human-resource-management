# ===========================================
# HR Management System - Environment Variables
# ===========================================

# Database Configuration
# ----------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrms_development
DB_USER=postgres
DB_PASSWORD=your_password_here

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# SSL Configuration (for production)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Logging
DB_LOGGING=true

# Test Database (for running tests)
# ---------------------------------
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=hrms_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=your_password_here

# Node Environment
# ----------------
NODE_ENV=development

# Supabase Configuration (optional - for cloud deployment)
# --------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# API Keys (optional - for AI features)
# -------------------------------------
VITE_OPENAI_API_KEY=your-openai-api-key-here
VITE_GEMINI_API_KEY=your-gemini-api-key-here
VITE_ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Analytics (optional)
# --------------------
VITE_GOOGLE_ANALYTICS_ID=your-google-analytics-id-here
VITE_ADSENSE_ID=your-adsense-id-here

# Other Services (optional)
# -------------------------
VITE_PERPLEXITY_API_KEY=your-perplexity-api-key-here
VITE_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-here

# ===========================================
# IMPORTANT: Never commit the actual .env file!
# Copy this file to .env and fill in your values.
# ===========================================
